# ============================================================
# RoboSphere API — Environment Variables
# Hosting pe (Render/Railway/VPS etc.) bas yeh fill karo:
#   DB_HOST, DB_PORT, DB_USER, DB_PASS, DB_NAME  +  JWT secrets
# First run pe site khud tables banayega (install wizard) —
# koi manual SQL nahi karna padega. Installed flag lagega aur
# site normal chalne lagega.
# ============================================================

# ---- Database (granular — hosting pe yahi type karte ho) ----
# DATABASE_URL explicitly diya ho to woh DB_* se precedence leta hai.
DB_HOST="localhost"
DB_PORT=3306
DB_USER="root"
DB_PASS=""
DB_NAME="switch_v2"
# Ya phir ek hi line me:
# DATABASE_URL="mysql://root:root@localhost:3306/switch_v2"

# ---- First-run admin (install wizard se create hoga) ----
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@robosphere.local"
ADMIN_PASSWORD="admin123"

# ---- JWT secrets (production me change karo!) ----
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES="7d"
JWT_REFRESH_EXPIRES="15m"

# ---- API server ----
API_PORT=4000
API_HOST=0.0.0.0

# CORS — comma-separated allowed origins for the web app
CORS_ORIGINS="http://localhost:5173"

# Log level: debug | info | warn | error
LOG_LEVEL="info"

# WiFi password encryption key — production me BADLO (koi bhi random 32+ char string)
# Isi se order ke WiFi passwords encrypt hote hain. Badalne se purane decrypt nahi honge!
WIFI_ENC_KEY="change-me-wifi-enc-key"

# Razorpay (khali chhodo to payment demo mode me chalega)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Jitsi / JaaS Configuration
JITSI_DOMAIN="meet.jit.si" # or "8x8.vc" for JaaS
JITSI_APP_ID=""
JITSI_API_KEY="" # or JITSI_KID
JITSI_PRIVATE_KEY="" # The private key content for generating JaaS JWTs

# UPI ID for demo UPI intent
UPI_ID="robosphere@upi"

# Cloudinary Integration (Photos/Images)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
