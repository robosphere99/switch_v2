# Example .env configuration for Expo Mobile App
# Expo will automatically bundle variables starting with EXPO_PUBLIC_

# If you are using a physical phone (Expo Go on the same WiFi),
# Replace 192.168.X.X with your Windows computer's local IPv4 Address.
# EXPO_PUBLIC_API_URL=http://192.168.1.100:4000/api

# If you are using the Android Emulator directly on your computer,
# 10.0.2.2 acts as "localhost".
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api
