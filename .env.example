# -----------------------------------------------------------------------------
# SwitchNest - Environment Variables Template
# 
# Instructions:
# 1. Copy this file and rename it to .env
# 2. Fill in the actual values for your local or production environment
# -----------------------------------------------------------------------------

# ---- Database Settings (Neon PostgreSQL) ----
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.neon.tech/dbname?sslmode=require"
NEON_BRANCH="production"

# ---- Authentication & Security ----
# Admin password (install wizard fallback + profile change se auto-sync)
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@robosphere.local"
ADMIN_PASSWORD="your-admin-password-here"

# JWT Secret + Expiration settings
# Generate a secure random string for JWT_SECRET (e.g. using `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET="your-jwt-secret-here"
JWT_ACCESS_EXPIRES="7d"
JWT_REFRESH_EXPIRES="15m"

# ---- Payment Gateway (Razorpay) ----
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# ---- AI Assist Mode (Phase 7) ----
AI_PROVIDER="gemini"
AI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
AI_MODEL="gemini-1.5-flash"

# ---- SMTP Settings (Email) ----
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587

# ---- Media Storage (Cloudinary) ----
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ---- Jitsi / JaaS Configuration (Video Calls) ----
JITSI_DOMAIN="8x8.vc"
JITSI_APP_ID="your_jitsi_app_id"
JITSI_API_KEY="your_jitsi_api_key"
JITSI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----"
